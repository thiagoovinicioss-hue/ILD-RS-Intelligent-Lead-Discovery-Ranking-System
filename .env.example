# ---- ILD-RS configuration -------------------------------------------
# Copy to `.env` and adjust. Never commit real keys.
# All variables can also be set as plain environment variables.

# Persistence (SQLite default; Postgres-ready, e.g.
#   postgresql+asyncpg://user:pass@host/dbname)
ILD_DATABASE_URL=sqlite+aiosqlite:///./ildrs.db

# Data source adapter: "fixture" (deterministic synthetic, no key) or "google_places"
ILD_SOURCE=fixture

# Google Places (New) API — set to enable the real provider
ILD_GOOGLE_PLACES_API_KEY=
ILD_GOOGLE_PLACES_REGION=
ILD_GOOGLE_PLACES_LANGUAGE=
ILD_GOOGLE_PLACES_TIMEOUT_SECONDS=15
ILD_GOOGLE_PLACES_RETRIES=3
ILD_GOOGLE_PLACES_BACKOFF_BASE_MS=400
ILD_GOOGLE_PLACES_MIN_INTERVAL_MS=200
ILD_GOOGLE_PLACES_CACHE_TTL_SECONDS=3600

# Discovery defaults
ILD_DISCOVERY_QUERY=plumbing services
ILD_DISCOVERY_LOCATION=
ILD_DISCOVERY_RADIUS_M=20000
ILD_DISCOVERY_LIMIT=50
ILD_DISCOVERY_CATEGORIES=plumber,contractor

# Website enrichment (opt-in; fetches business sites with a short timeout)
ILD_ENABLE_WEBSITE_ANALYSIS=false
ILD_WEBSITE_ANALYSIS_TIMEOUT_SECONDS=5

# Rating engine
ILD_RATING_MODEL=v1
ILD_RATING_MIN_SAMPLES=20

# Feature weights (optional overrides; normalized internally)
ILD_WEIGHT_WEB_PRESENCE=0.18
ILD_WEIGHT_RATING_SCORE=0.13
ILD_WEIGHT_REVIEW_VOLUME=0.13
ILD_WEIGHT_BUSINESS_STATUS=0.08
ILD_WEIGHT_CONTACT_AVAIL=0.13
ILD_WEIGHT_CATEGORY_FIT=0.13
ILD_WEIGHT_LOCATION_FIT=0.08
ILD_WEIGHT_WEBSITE_QUALITY=0.05
ILD_WEIGHT_BUSINESS_COMPLETENESS=0.05
ILD_WEIGHT_RECENT_ACTIVITY=0.02
ILD_WEIGHT_SOCIAL_PRESENCE=0.01
ILD_WEIGHT_SOCIAL_ACTIVITY=0.01

# Scheduling cadence (hours)
ILD_VERIFY_INTERVAL_HOURS=24
ILD_REFRESH_INTERVAL_HOURS=6

# Notifications (optional webhook; DB + console always on)
ILD_NOTIFY_WEBHOOK_URL=

# API server
ILD_API_HOST=127.0.0.1
ILD_API_PORT=8080

# Observability
ILD_LOG_LEVEL=INFO
ILD_LOG_JSON=0
